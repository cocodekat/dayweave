    {
      "id": "latin-start-from-zero",
      "subject": "latin",
      "kind": "lesson",
      "group": "Begin hier",
      "stage": "Stap 1",
      "title": "Naamvallen vanaf nul",
      "summary": "Leer eerst de begrippen voordat je de uitgangen oefent.",
      "cards": [
        {
          "id": "latin-zero-1",
          "question": "Wat is de nominativus?",
          "answer": "De naamval van het onderwerp: wie of wat doet iets?"
        },
        {
          "id": "latin-zero-2",
          "question": "Wat is de dativus?",
          "answer": "De naamval van het meewerkend voorwerp: aan of voor wie?"
        },
        {
          "id": "latin-zero-3",
          "question": "Wat is de accusativus?",
          "answer": "De naamval van het lijdend voorwerp: wie of wat ondergaat de handeling?"
        },
        {
          "id": "latin-zero-4",
          "question": "Wat betekent enkelvoud?",
          "answer": "Eén persoon, dier of ding."
        },
        {
          "id": "latin-zero-5",
          "question": "Wat betekent meervoud?",
          "answer": "Meer dan één persoon, dier of ding."
        },
        {
          "id": "latin-zero-6",
          "question": "Welke vier stappen gebruik je bij verbuigen?",
          "answer": "Bepaal naamval, bepaal getal, kies verbuigingsgroep en kies de uitgang."
        },
        {
          "id": "latin-zero-7",
          "question": "Waarvoor gebruik je de tweede woordenboekvorm?",
          "answer": "Om de verbuigingsgroep en de stam van het woord te vinden."
        }
      ]
    },
